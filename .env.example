# Formspree CLI. From the project's Settings tab at formspree.io.
FORMSPREE_DEPLOY_KEY=
NEXT_PUBLIC_FORMSPREE_PROJECT_ID=

# Cloudflare Worker deploy. Must be the EXCS account.
# A local wrangler login can be the wrong account (id d058c8ec4c5caeadbd55cf293f3d2d32).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Interest-list export. This is a Worker secret, not a Next.js env var.
# Production: npx wrangler secret put EXPORT_TOKEN
# Local wrangler dev: put EXPORT_TOKEN=... in .dev.vars (gitignored).

# Admin sign-in (Cloudflare Access). Worker secrets, not Next.js env vars.
# npx wrangler secret put ACCESS_TEAM_DOMAIN   # team hostname, with or without https://
# npx wrangler secret put ACCESS_AUD           # Access application audience tag
# ADMIN_EMAILS defaults to kazybekkhairulla@gmail.com (see wrangler.jsonc vars).
