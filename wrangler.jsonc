{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Cloudflare Workers config for the ExeHacks site.
	//
	// This project is a Next.js STATIC EXPORT (`output: "export"` in
	// next.config.mjs). `next build` writes plain files to ./out and never
	// produces a server bundle. There is no .next/standalone directory.
	//
	// `main` serves /api/* and /admin*. Every other path is still served from
	// ./out. An explicit main also stops `wrangler deploy` from auto-detecting
	// Next.js and migrating the project onto the OpenNext adapter, which a
	// static export cannot satisfy.
	//
	// Workers Builds (Settings → Build) on the EXCS account:
	//   Build command:  npm run build
	//   Deploy command: npm run deploy
	//   Build variables: FORMSPREE_DEPLOY_KEY, NEXT_PUBLIC_FORMSPREE_PROJECT_ID
	//   Secrets (once):
	//     npx wrangler secret put EXPORT_TOKEN
	//     npx wrangler secret put ACCESS_TEAM_DOMAIN
	//     npx wrangler secret put ACCESS_AUD
	//
	// Do not run `wrangler deploy` from the wrong Cloudflare account
	// (id d058c8ec4c5caeadbd55cf293f3d2d32). `wrangler whoami` must show the
	// Exeter Computer Science Society account. Pin that account with
	// CLOUDFLARE_ACCOUNT_ID before deploying.
	"name": "hack-sw-website",
	"main": "worker/index.js",

	// Kept a little behind today so it can never be ahead of the runtime the
	// deploy lands on. The build log showed workerd 1.20260811.1.
	"compatibility_date": "2026-08-01",

	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		// Interest API, admin API, and the admin page. Other pages stay on the asset bundle.
		// A trailing * covers nested paths such as /api/interest/export.csv and /admin/.
		"run_worker_first": ["/api/*", "/admin*"],
		// Next emits /sponsor/index.html (trailingSlash: true). Force the slash so
		// /sponsor and /sponsor/ both resolve, matching the export.
		"html_handling": "force-trailing-slash",
		// Serve the exported out/404.html for unknown paths.
		"not_found_handling": "404-page"
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "exehacks-interest",
			"database_id": "fca01d5a-1608-4881-a6a0-3a9af696b6b2",
			"migrations_dir": "migrations"
		}
	],

	// Comma-separated allow-list checked after the Cloudflare Access JWT.
	// Override in the dashboard or with `wrangler secret put ADMIN_EMAILS` if it changes.
	"vars": {
		"ADMIN_EMAILS": "kazybekkhairulla@gmail.com"
	}
}
